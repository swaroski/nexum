  "cards": [
    {
      "dot": "violet",
      "title": "Attenuation, every hop",
      "items": [
        "Child capabilities \u2286 parent's delegatable set; resources, audience \u2286 parent's",
        "Child expires no later than parent; depth strictly decreases",
        "Child is signed by the parent's holder key and bound to the parent's hash"
      ]
    },
    {
      "dot": "rose",
      "title": "What the sub-agent cannot do",
      "items": [
        "Call payment.execute: not in its chain (NX-4032), and ABC's trust list denies it",
        "Mint itself new authority: its grant allows no further delegation (NX-1015)"
      ]
    },
    {
      "dot": "cyan",
      "title": "No middleman",
      "items": [
        "ABC trusts only XYZ's public key, under ABC's own policy",
        "No shared secret; revoking xyz.com stops every XYZ grant at once"
      ]
    }
  ]
