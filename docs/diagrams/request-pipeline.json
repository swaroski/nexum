  "cards": [
    {
      "dot": "rose",
      "title": "Fail closed",
      "items": [
        "Every check that fails returns DENY with one stable NX-xxxx code",
        "PDP errors and approval-store errors deny as well",
        "An audit write failure turns any decision into DENY"
      ]
    },
    {
      "dot": "cyan",
      "title": "Neutral core",
      "items": [
        "Adapters only describe the message; they never decide",
        "The pipeline sees identity, delegation, action, resource and policy only"
      ]
    }
  ]
